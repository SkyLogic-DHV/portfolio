generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AdminUser {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String   @unique
  name      String?
  role      String   @default("ADMIN")
  deactive  Boolean  @default(false) // true = disabled admin account
  createdById String?
  createdBy   AdminUser? @relation("AdminCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAdmins AdminUser[] @relation("AdminCreatedBy")
  clientProjects ClientProject[] // reverse relation for assigned projects
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OtpToken {
  id        String   @id @default(uuid())
  email     String
  otp       String
  expiresAt DateTime
  used      Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
}

model TeamMember {
  id           String   @id @default(uuid())
  name         String
  role         String
  bio          String
  avatar       String   @default("")
  linkedin     String   @default("")
  github       String   @default("")
  instagram    String   @default("")
  email        String   @default("")
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model TeamSectionInfo {
  id          String   @id @default("default")
  title       String   @default("Meet Our Engineering Team")
  description String   @default("Architects, full-stack developers, and designers crafting world-class digital products.")
  updatedAt   DateTime @updatedAt
}

model Project {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  thumbnail   String   @default("")
  gallery     String   @default("[]")
  shortDesc   String   @db.Text
  longDesc    String   @db.Text
  techStack   String   @default("[]")
  githubUrl   String   @default("")
  demoUrl     String   @default("")
  year        String   @default("2026")
  duration    String   @default("3 Months")
  category    String   @default("Website")
  status      String   @default("Completed")
  featured    Boolean  @default(false)
  highlight   String   @default("")
  projectType String   @default("Enterprise")
  challenge   String   @default("") @db.Text
  solution    String   @default("") @db.Text
  result      String   @default("") @db.Text
  screenshots String   @default("[]")
  videoDemo   String   @default("")
  seoImage    String   @default("")
  isActive    Boolean  @default(true) // Switch to display/hide on public website
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ClientProject {
  id            String   @id @default(uuid())
  title         String
  clientName    String   @default("")
  status        String   @default("To Do")
  assignedAdminId String?
  assignedAdmin AdminUser? @relation(fields: [assignedAdminId], references: [id], onDelete: SetNull)
  orderedAt     DateTime?
  completedAt   DateTime?
  revisionUsed  Int      @default(0)
  revisionLimit Int      @default(2)
  expiresAt     DateTime?
  priority      String   @default("Medium")
  description   String   @default("")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model TechStack {
  id           String   @id @default(uuid())
  name         String
  image        String   @default("")
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true) // Switch to display/hide on public website
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PublicService {
  id           String   @id @default(uuid())
  icon         String   @default("Code") // logo/ikon untuk card di web public
  title        String
  description  String
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true) // Switch to display/hide on public website
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Service {
  id           String   @id @default(uuid())
  icon         String   @default("Code")
  title        String
  description  String
  cta          String   @default("Learn More")
  price        String   @default("") // Harga layanan (misal: "500K", "1.5M")
  features     String   @default("[]") // JSON array berisi fitur/fitur unggulan
  popular      Boolean  @default(false) // Paket yang paling direkomendasikan
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true) // Switch to display/hide on public website
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ContactInfo {
  id            String   @id @default("default")
  email         String   @default("contact@skylogic.id")
  whatsapp      String   @default("+6281316881677")
  instagram     String   @default("https://instagram.com/skylogic.id")
  linkedin      String   @default("https://linkedin.com/company/skylogic")
  github        String   @default("https://github.com/skylogic")
  discord       String   @default("https://discord.gg/skylogic")
  telegram      String   @default("https://t.me/skylogic")
  address       String   @default("Jakarta, Indonesia")
  googleMapsUrl String   @default("https://maps.google.com")
  updatedAt     DateTime @updatedAt
}

model LeaveYourMark {
  id         String   @id @default(uuid())
  name       String
  message    String
  color      String   @default("yellow")
  isPinned   Boolean  @default(false)
  isApproved Boolean  @default(true)
  isHidden   Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model VisitorLog {
  id              String   @id @default(uuid())
  ip              String   @default("127.0.0.1")
  path            String   @default("/")
  device          String   @default("Desktop")
  browser         String   @default("Chrome")
  os              String   @default("Windows")
  country         String   @default("Indonesia")
  city            String   @default("Jakarta")
  referral        String   @default("Direct")
  sessionDuration Int      @default(0)
  createdAt       DateTime @default(now())
}

model MediaFile {
  id           String   @id @default(uuid())
  filename     String
  originalName String
  url          String
  mimeType     String
  size         Int
  folder       String   @default("general")
  createdAt    DateTime @default(now())
}

model SiteSetting {
  id              String   @id @default("default")
  siteName        String   @default("SkyLogic")
  logo            String   @default("")
  favicon         String   @default("")
  footerText      String   @default("Empowering businesses with software built from scratch.")
  copyright       String   @default("© 2026 SkyLogic Inc. All rights reserved.")
  primaryColor    String   @default("#6366F1")
  secondaryColor  String   @default("#06B6D4")
  darkModeDefault Boolean  @default(false)
  metaTitle       String   @default("SkyLogic - We Build From Scratch")
  metaDescription String   @default("Leading software engineering company building high-performance web applications.")
  ogImage         String   @default("")
  robots          String   @default("index, follow")
  sitemap         String   @default("https://skylogic.id/sitemap.xml")
  pricingTag      String   @default("Transparent & Affordable")
  pricingTitle    String   @default("Pricing Tailored to Your Needs")
  pricingDescription String @default("Choose the plan that fits your vision. No hidden costs.")
  updatedAt       DateTime @updatedAt
}
